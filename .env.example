# Copy this file to .env for local development. Never commit real values.
PORT=3002
APP_URL=http://localhost:3000
MYSQL_URL=mysql://havn_user:change-me@127.0.0.1:3306/havn_store

SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters
SUPER_ADMIN_NAME=Super Admin

# Stripe test/live API keys. Register /api/webhooks/stripe for checkout.session.completed,
# checkout.session.expired, and checkout.session.async_payment_failed events.
STRIPE_SECRET_KEY=sk_test_replace-me
STRIPE_WEBHOOK_SECRET=whsec_replace-me

# Optional, used by the existing AI assistant feature.
GEMINI_API_KEY=
