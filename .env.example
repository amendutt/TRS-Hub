# Copy this file to .env for local development. Never commit real values.
PORT=3002
APP_URL=http://localhost:3000
MYSQL_URL=mysql://havn_user:change-me@127.0.0.1:3306/havn_store

# Firebase Admin service-account JSON as a single-line JSON string.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"replace-me","private_key_id":"replace-me","private_key":"-----BEGIN PRIVATE KEY-----\\nreplace-me\\n-----END PRIVATE KEY-----\\n","client_email":"firebase-adminsdk@replace-me.iam.gserviceaccount.com","client_id":"replace-me","token_uri":"https://oauth2.googleapis.com/token"}
ADMIN_EMAILS=you@example.com

# Stripe test/live API keys. Register /api/webhooks/stripe for checkout.session.completed,
# checkout.session.expired, and checkout.session.async_payment_failed events.
STRIPE_SECRET_KEY=sk_test_replace-me
STRIPE_WEBHOOK_SECRET=whsec_replace-me

# Firebase Web App config. Enable Google, Email/Password, and Phone auth providers,
# then add your production domain to Firebase Auth's authorized domains.
VITE_FIREBASE_API_KEY=replace-me
VITE_FIREBASE_AUTH_DOMAIN=replace-me.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=replace-me
VITE_FIREBASE_APP_ID=replace-me
VITE_FIREBASE_MESSAGING_SENDER_ID=replace-me

# Optional, used by the existing AI assistant feature.
GEMINI_API_KEY=
